APP_NAME=Asesor Pedagogico Inteligente
DATABASE_URL=sqlite:///./storage/asesor_pedagogico.db
UPLOAD_DIR=./storage/evidencias
MAX_UPLOAD_MB=25
# Configuración futura de proveedor IA (no se usa en el evaluador simulado)
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=

# Autenticación
APP_ENV=development
# En producción define una clave larga y aleatoria (por ejemplo: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=
JWT_EXPIRE_MINUTES=480
# Solo producción: cuenta de docente que se crea al iniciar
DOCENTE_NAME=Docente
DOCENTE_EMAIL=
DOCENTE_PASSWORD=
